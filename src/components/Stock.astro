---
interface Props {
    disponibilidad?: 'disponible' | 'agotado' | 'bajo'; // Hacemos la prop opcional
}

const { disponibilidad = 'agotado' } = Astro.props;

const estados = {
    disponible: {
        color: 'bg-green-100 text-green-700',
        texto: 'En stock',
        icono: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`
    },
    agotado: {
        color: 'bg-red-100 text-red-700',
        texto: 'Agotado',
        icono: `<path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />`
    },
    bajo: {
        color: 'bg-yellow-100 text-yellow-700',
        texto: 'Pocas unidades',
        icono: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />`
    }
};

const estado = estados[disponibilidad];
---

<div class={`inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ${estado.color}`}>
    <svg class="mr-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" set:html={estado.icono} />
    {estado.texto}
</div>
