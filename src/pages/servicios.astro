---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import ParallaxHero from '../components/ParallaxHero.astro';

const beneficios = [
    {
        titulo: "Productos Originales",
        descripcion: "Garantizamos la autenticidad de todos nuestros productos y servicios",
        icono: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`
    },
    {
        titulo: "Asesoría Especializada",
        descripcion: "Personal capacitado para brindarte el mejor servicio técnico",
        icono: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />`
    },
    {
        titulo: "Servicio Garantizado",
        descripcion: "Respaldamos la calidad de nuestro trabajo con garantía",
        icono: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />`
    }
];

export let title = 'Servicios';
---

<Layout>
	<main>
		<FadeIn>
			<ParallaxHero
				imageSrc="/img/banners/servicio.jpg"
				imageAlt="Servicio Automotriz"
			>
				<Container>
					<div class="py-28 sm:py-36">
						<div class="mx-auto max-w-3xl text-center">
							<span class="inline-flex items-center gap-2 px-3 py-1 text-sm font-medium text-red-400 bg-red-400/10 rounded-full mb-6">
								<span class="w-1 h-1 rounded-full bg-red-400"></span>
								Servicios Profesionales
								<span class="w-1 h-1 rounded-full bg-red-400"></span>
							</span>
							<h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl mb-8">
								Mantenimiento Profesional de Excelencia
							</h1>
							<p class="text-xl/8 text-gray-300 mx-auto max-w-2xl">
								Confía en nuestro equipo de técnicos certificados para mantener tu vehículo en óptimas condiciones.
							</p>
						</div>
					</div>
				</Container>
			</ParallaxHero>
		</FadeIn>

		<!-- Banner de Beneficios Mejorado -->
		<FadeIn delay="0.2s">
			<div class="relative -mt-12 z-10 mb-16">
				<Container>
					<div class="mx-auto max-w-7xl px-6 lg:px-8">
						<div class="bg-white rounded-2xl shadow-xl ring-1 ring-gray-200/50 p-8">
							<div class="grid grid-cols-1 gap-y-8 gap-x-6 md:grid-cols-3">
								{beneficios.map((beneficio) => (
									<div class="relative pl-16">
										<div class="absolute left-0 top-0 flex h-12 w-12 items-center justify-center rounded-xl bg-red-600 text-white">
											<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
												<Fragment set:html={beneficio.icono} />
											</svg>
										</div>
										<h3 class="text-lg font-semibold text-gray-900 mb-2">{beneficio.titulo}</h3>
										<p class="text-gray-600 text-sm">{beneficio.descripcion}</p>
									</div>
								))}
							</div>
						</div>
					</div>
				</Container>
			</div>
		</FadeIn>

		<!-- Servicios Grid Mejorado -->
		<div class="bg-gray-50/50 py-8 -mt-8">
			<Container>
				<div class="mx-auto max-w-7xl px-6 lg:px-8">
					<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
						{/* Cambio de Aceite */}
						<FadeIn delay="0.3s">
							<div class="group relative overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-gray-200/50 transition-all duration-300 hover:shadow-xl">
								<div class="p-8">
									<div class="flex items-center gap-x-4 mb-6">
										<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-red-600 group-hover:bg-red-700 transition-colors">
											<svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-2.25-1.313M21 7.5v2.25m0-2.25l-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3l2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75l2.25-1.313M12 21.75V19.5m0 2.25l-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25" />
											</svg>
										</div>
										<h3 class="text-xl font-semibold text-gray-900">Cambio de Aceite Profesional</h3>
									</div>
									<p class="text-gray-600 mb-6">Utilizamos aceites de la más alta calidad y realizamos un diagnóstico completo del sistema de lubricación.</p>
									<ul class="space-y-3">
										{['Aceites sintéticos y minerales', 'Cambio de filtro de aceite', 'Revisión de niveles'].map((item) => (
											<li class="flex items-center gap-x-3 text-gray-600">
												<svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
												</svg>
												{item}
											</li>
										))}
									</ul>
								</div>
								<div class="mt-4 bg-gray-50 p-6 border-t border-gray-100">
									<a href="/contacto" class="inline-flex items-center text-sm font-medium text-red-600 hover:text-red-700">
										Solicitar servicio
										<svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
										</svg>
									</a>
								</div>
							</div>
						</FadeIn>

						{/* Filtros */}
						<FadeIn delay="0.4s">
							<div class="group relative overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-gray-200/50 transition-all duration-300 hover:shadow-xl">
								<div class="p-8">
									<div class="flex items-center gap-x-4 mb-6">
										<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-red-600 group-hover:bg-red-700 transition-colors">
											<svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
											</svg>
										</div>
										<h3 class="text-xl font-semibold text-gray-900">Cambio de Filtros</h3>
									</div>
									<p class="text-gray-600 mb-6">Mantenemos tu motor protegido con filtros de alta calidad para un óptimo rendimiento.</p>
									<ul class="space-y-3">
										{['Filtro de aire', 'Filtro de combustible', 'Filtro de habitáculo'].map((item) => (
											<li class="flex items-center gap-x-3 text-gray-600">
												<svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
												</svg>
												{item}
											</li>
										))}
									</ul>
								</div>
								<div class="mt-4 bg-gray-50 p-6 border-t border-gray-100">
									<a href="/contacto" class="inline-flex items-center text-sm font-medium text-red-600 hover:text-red-700">
										Solicitar servicio
										<svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
										</svg>
									</a>
								</div>
							</div>
						</FadeIn>

						{/* Filtros Especializados */}
						<FadeIn delay="0.5s">
							<div class="group relative overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-gray-200/50 transition-all duration-300 hover:shadow-xl">
								<div class="p-8">
									<div class="flex items-center gap-x-4 mb-6">
										<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-red-600 group-hover:bg-red-700 transition-colors">
											<svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
											</svg>
										</div>
										<h3 class="text-xl font-semibold text-gray-900">Filtros Especializados</h3>
									</div>
									<p class="text-gray-600 mb-6">Mantenimiento completo del sistema de filtrado para un óptimo rendimiento.</p>
									<ul class="space-y-3">
										{['Filtro de petróleo', 'Decantador', 'Filtros industriales'].map((item) => (
											<li class="flex items-center gap-x-3 text-gray-600">
												<svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
												</svg>
												{item}
											</li>
										))}
									</ul>
								</div>
								<div class="mt-4 bg-gray-50 p-6 border-t border-gray-100">
									<a href="/contacto" class="inline-flex items-center text-sm font-medium text-red-600 hover:text-red-700">
										Solicitar servicio
										<svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
										</svg>
									</a>
								</div>
							</div>
						</FadeIn>

						{/* Servicios Adicionales */}
						<FadeIn delay="0.6s">
							<div class="group relative overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-gray-200/50 transition-all duration-300 hover:shadow-xl">
								<div class="p-8">
									<div class="flex items-center gap-x-4 mb-6">
										<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-red-600 group-hover:bg-red-700 transition-colors">
											<svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" />
											</svg>
										</div>
										<h3 class="text-xl font-semibold text-gray-900">Servicios Adicionales</h3>
									</div>
									<p class="text-gray-600 mb-6">Servicios complementarios para el óptimo funcionamiento de tu vehículo.</p>
									<ul class="space-y-3">
										{[
											'Cambio de bujías',
											'Reemplazo de líquido refrigerante',
											'Revisión de niveles',
											'Engrase'
										].map((item) => (
											<li class="flex items-center gap-x-3 text-gray-600">
												<svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
												</svg>
												{item}
											</li>
										))}
									</ul>
								</div>
								<div class="mt-4 bg-gray-50 p-6 border-t border-gray-100">
									<a href="/contacto" class="inline-flex items-center text-sm font-medium text-red-600 hover:text-red-700">
										Solicitar servicio
										<svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
										</svg>
									</a>
								</div>
							</div>
						</FadeIn>
					</div>
				</div>
			</Container>
		</FadeIn>

		<!-- Servicio Express Mejorado -->
		<FadeIn delay="0.4s">
			<div class="relative py-16">
				<Container>
					<div class="mx-auto max-w-7xl px-6 lg:px-8">
						<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-gray-900 via-gray-800 to-black">
							<div class="absolute inset-0 opacity-10"></div>
							
							<div class="relative px-8 py-16 sm:px-16 sm:py-24 lg:flex lg:items-center lg:gap-x-10">
								<div class="max-w-xl lg:mx-0">
									<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
										Servicio Express
									</h2>
									<p class="mt-6 text-lg leading-8 text-gray-300">
										No pierdas tiempo. Realiza el mantenimiento de tu vehículo sin cita previa. Rápido y profesional.
									</p>
									
									<dl class="mt-10 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
										{[
											'Atención inmediata',
											'Diagnóstico gratuito',
											'Personal certificado',
											'Servicio garantizado'
										].map((feature) => (
											<div class="flex items-center gap-x-3">
												<dt class="flex-none">
													<span class="sr-only">Incluye</span>
													<svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
														<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
													</svg>
												</dt>
												<dd class="text-base text-gray-300">{feature}</dd>
											</div>
										))}
									</dl>

									<div class="mt-10 flex flex-col sm:flex-row gap-4">
										<a href="/contacto" 
										   class="inline-flex items-center justify-center rounded-xl bg-red-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-red-500 transition-all duration-300">
											Agendar servicio
										</a>
										<a href="https://wa.me/56912345678" 
										   class="inline-flex items-center justify-center rounded-xl bg-white/10 backdrop-blur-sm px-6 py-3 text-sm font-semibold text-white hover:bg-white/20 transition-all duration-300">
											<svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
												<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
											</svg>
											WhatsApp
										</a>
									</div>
								</div>

								<!-- Promociones -->
								<div class="mt-16 sm:mt-24 lg:mt-0 lg:flex-shrink-0 lg:flex-grow">
									<div class="rounded-2xl bg-white/5 backdrop-blur-xl ring-1 ring-white/10 p-8">
										<h3 class="text-lg font-semibold leading-8 text-white mb-6">Promociones Especiales</h3>
										<div class="space-y-4">
											<div class="flex gap-x-4 rounded-lg bg-white/5 p-4">
												<svg class="h-6 w-6 flex-none text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
												</svg>
												<div class="text-sm leading-6 text-gray-300">
													<strong class="font-semibold text-white">10% Descuento</strong><br/>
													En cambios de aceite los días lunes
												</div>
											</div>
											<div class="flex gap-x-4 rounded-lg bg-white/5 p-4">
												<svg class="h-6 w-6 flex-none text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
												</svg>
												<div class="text-sm leading-6 text-gray-300">
													<strong class="font-semibold text-white">Diagnóstico Gratis</strong><br/>
													En tu primera visita
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</Container>
			</div>
		</FadeIn>

		<!-- CTA Final Mejorado -->
		<FadeIn delay="0.3s">
			<div class="bg-white py-16">
				<Container>
					<div class="relative isolate overflow-hidden bg-gradient-to-br from-red-600/90 to-red-700/90 rounded-3xl">
						<div class="absolute inset-0 -z-10 opacity-20 mix-blend-multiply">
							<img src="" alt="" class="h-full w-full object-cover"/>
						</div>
						
						<div class="mx-auto max-w-4xl px-6 py-16 sm:py-20 lg:px-8 text-center">
							<h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
								¿Necesitas asesoría personalizada?
							</h2>
							<p class="mx-auto mt-4 max-w-xl text-lg leading-8 text-red-100">
								Nuestros expertos están listos para ayudarte con el mantenimiento de tu vehículo.
							</p>
