---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import ParallaxHero from '../components/ParallaxHero.astro';

export let title = 'Contacto';
---

<Layout>
	<main>
		<FadeIn>
			<ParallaxHero
				imageSrc="/img/banners/contacto-bg.webp"
				imageAlt="Contáctanos"
			>
				<Container>
					<div class="py-28 sm:py-36">
						<div class="mx-auto max-w-3xl text-center">
							<span class="inline-flex items-center gap-2 px-3 py-1 text-sm font-medium text-red-400 bg-red-400/10 rounded-full mb-6">
								<span class="w-1 h-1 rounded-full bg-red-400"></span>
								Contáctanos
								<span class="w-1 h-1 rounded-full bg-red-400"></span>
							</span>
							<h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl mb-8">
								¿Cómo Podemos Ayudarte?
							</h1>
							<p class="text-xl/8 text-gray-300 mx-auto max-w-2xl">
								Estamos aquí para responder tus preguntas y brindarte la mejor atención.
							</p>
						</div>
					</div>
				</Container>
			</ParallaxHero>
		</FadeIn>

		<FadeIn delay="0.2s">
			<Container>
				<!-- Cards de Contacto Rápido -->
				<div class="relative -mt-16 z-10 mb-16">
					<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
						<!-- WhatsApp -->
						<a href="https://wa.me/56912345678" 
						   class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-200/50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
							<div class="flex items-center gap-4">
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-green-500 text-white">
									<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
										<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-gray-900">WhatsApp</h3>
									<p class="text-sm text-gray-600">Respuesta inmediata</p>
								</div>
							</div>
						</a>

						<!-- Teléfono -->
						<a href="tel:+56912345678" 
						   class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-200/50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
							<div class="flex items-center gap-4">
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-600 text-white">
									<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-gray-900">Llámanos</h3>
									<p class="text-sm text-gray-600">+56 9 1234 5678</p>
								</div>
							</div>
						</a>

						<!-- Email -->
						<a href="mailto:contacto@lubricentrolaesquina.cl" 
						   class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg ring-1 ring-gray-200/50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
							<div class="flex items-center gap-4">
								<div class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-900 text-white">
									<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-gray-900">Email</h3>
									<p class="text-sm text-gray-600">Lubricentrolaesquina7@gmail.com</p>
								</div>
							</div>
						</a>
					</div>
				</div>

				<!-- Contenido Principal -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 py-16">
					<!-- Formulario -->
					<div class="bg-white p-8 rounded-2xl shadow-lg ring-1 ring-gray-200/50">
						<h2 class="text-2xl font-bold text-gray-900 mb-8">Envíanos un mensaje</h2>
						<form class="space-y-6">
							<div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
								<div class="sm:col-span-2">
									<label for="nombre" class="block text-sm font-semibold leading-6 text-gray-900">Nombre</label>
									<input 
										type="text" 
										name="nombre" 
										id="nombre" 
										placeholder="Ej: Juan Pérez"
										class="mt-2.5 block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6">
								</div>
								<div class="sm:col-span-2">
									<label for="email" class="block text-sm font-semibold leading-6 text-gray-900">Email</label>
									<input 
										type="email" 
										name="email" 
										id="email" 
										placeholder="ejemplo@correo.com"
										class="mt-2.5 block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6">
								</div>
								<div class="sm:col-span-2">
									<label for="telefono" class="block text-sm font-semibold leading-6 text-gray-900">Teléfono</label>
									<input 
										type="tel" 
										name="telefono" 
										id="telefono" 
										placeholder="+56 9 1234 5678"
										class="mt-2.5 block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6">
								</div>
								<div class="sm:col-span-2">
									<label for="mensaje" class="block text-sm font-semibold leading-6 text-gray-900">Mensaje</label>
									<textarea 
										name="mensaje" 
										id="mensaje" 
										rows="4" 
										placeholder="Escribe aquí tu consulta o mensaje..."
										class="mt-2.5 block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 sm:text-sm sm:leading-6"></textarea>
								</div>
							</div>
							<div class="mt-8 flex justify-end">
								<button type="submit" class="rounded-md bg-red-600 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">Enviar mensaje</button>
							</div>
						</form>
					</div>

					<!-- Info y Mapa -->
					<div class="space-y-8">
						<!-- Horarios -->
						<div class="bg-white p-8 rounded-2xl shadow-lg ring-1 ring-gray-200/50">
							<h3 class="text-xl font-bold text-gray-900 mb-6">Horario de Atención</h3>
							<div class="space-y-4">
								<div class="flex justify-between items-center">
									<span class="text-gray-600">Lunes a Viernes</span>
									<span class="font-semibold">9:00 AM - 6:00 PM</span>
								</div>
								<div class="flex justify-between items-center">
									<span class="text-gray-600">Sábados</span>
									<span class="font-semibold">10:00 AM - 3:00 PM</span>
								</div>
								<div class="flex justify-between items-center">
									<span class="text-gray-600">Domingos</span>
									<span class="font-semibold text-red-600">Cerrado</span>
								</div>
							</div>
						</div>

						<!-- Mapa -->
						<div class="bg-white p-8 rounded-2xl shadow-lg ring-1 ring-gray-200/50">
							<h3 class="text-xl font-bold text-gray-900 mb-6">Ubicación</h3>
							<div class="rounded-lg overflow-hidden">
								<iframe 
									class="w-full h-[300px]" 
									src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3327.2105600871505!2d-70.6314644234341!3d-33.495898499842546!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662db87d0030383%3A0xf2a051a52f67b160!2sLUBRICENTRO%20LA%20ESQUINA!5e0!3m2!1ses-419!2scl!4v1738964158256!5m2!1ses-419!2scl" 
									style="border:0;" 
									allowfullscreen="" 
									loading="lazy">
								</iframe>
							</div>
							<p class="mt-4 text-gray-600">
								Av salvador allende, Av. Las Industrias 201<br>
								San Joaquin, Region Metropolitana
							</p>
						</div>
					</div>
				</div>
			</Container>
		</FadeIn>
	</main>
</Layout>