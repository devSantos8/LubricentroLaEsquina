---
import "../styles/global.css";
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import FadeIn from '../components/FadeIn.astro';
import ParallaxHero from '../components/ParallaxHero.astro';

const stats = [
    { value: '35+', label: 'Años de Experiencia' },
    { value: '10k+', label: 'Servicios Realizados' },
    { value: '98%', label: 'Clientes Satisfechos' }
];

const valores = [
    {
        titulo: "Excelencia Técnica",
        descripcion: "Nuestro equipo está certificado y en constante capacitación",
        icono: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
    },
    {
        titulo: "Clientes Satisfechos",
        descripcion: "Clientes que confian en nuestros servicios y productos",
        icono: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
    },
    {
        titulo: "Garantía de Servicio",
        descripcion: "Respaldamos todos nuestros servicios y productos",
        icono: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
    }
];


export let title = 'Nosotros';
---

<Layout>
    <main>
        <FadeIn>
            <ParallaxHero
                imageSrc="/img/banners/nosotros-bg.jpg"
                imageAlt="Nuestro Equipo"
            >
                <Container>
                    <div class="py-28 sm:py-36">
                        <div class="mx-auto max-w-3xl text-center">
                            <span class="inline-flex items-center gap-2 px-3 py-1 text-sm font-medium text-red-400 bg-red-400/10 rounded-full mb-6">
                                <span class="w-1 h-1 rounded-full bg-red-400"></span>
                                Sobre Nosotros
                                <span class="w-1 h-1 rounded-full bg-red-400"></span>
                            </span>
                            <h1 class="text-5xl font-bold tracking-tight text-white sm:text-6xl mb-8">
                                Nuestra Historia y Compromiso
                            </h1>
                            <p class="text-xl/8 text-gray-300 mx-auto max-w-2xl">
                                Más de una década de experiencia brindando servicios de calidad y soluciones automotrices.
                            </p>
                        </div>
                    </div>
                </Container>
            </ParallaxHero>
        </FadeIn>

        <FadeIn delay="0.2s">
            <!-- Stats Section -->
            <div class="relative -mt-12 z-10 mb-12">
                <Container>
                    <div class="mx-auto max-w-5xl px-4 lg:px-6">
                        <div class="bg-white rounded-2xl shadow-xl ring-1 ring-gray-200/50 py-8">
                            <div class="mx-auto grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-3 px-6">
                                {stats.map(({ value, label }) => (
                                    <div class="flex flex-col items-center">
                                        <dt class="text-3xl font-bold tracking-tight text-red-600 mb-1">
                                            {value}
                                        </dt>
                                        <dd class="text-sm text-gray-600">
                                            {label}
                                        </dd>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </Container>
            </div>
        </FadeIn>

        <Container>
            <FadeIn delay="0.2s">
                <!-- Sobre Nosotros con Grid de Imágenes -->
                <div class="py-16">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <div>
                            <h2 class="text-3xl font-bold text-gray-900 mb-6">Sobre <span class="text-red-600">Nosotros</span></h2>
                            <div class="space-y-4">
                                <p class="text-lg leading-relaxed text-gray-600">
                                    En <span class="text-red-600 font-semibold">Lubricentro La Esquina</span>, nos dedicamos a proporcionar servicios de mantenimiento automotriz de primera calidad, especializándonos en lubricación y cuidado integral de vehículos.
                                </p>
                                <p class="text-lg leading-relaxed text-gray-600">
                                    Nuestro compromiso con la excelencia se refleja en cada servicio que realizamos, utilizando productos de las mejores marcas y la experiencia de años para garantizar resultados óptimos.
                                </p>
                            </div>
                            
                            <!-- Valores de la Empresa -->
                            <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6">
                                {valores.map((valor) => (
                                    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                                        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-red-600 text-white mb-4">
                                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" d={valor.icono} />
                                            </svg>
                                        </div>
                                        <h3 class="text-lg font-semibold text-gray-900 mb-2">{valor.titulo}</h3>
                                        <p class="text-sm text-gray-600">{valor.descripcion}</p>
                                    </div>
                                ))}
                            </div>
                        </div>
                        
                        <!-- Grid de Imágenes -->
                        <div class="grid grid-cols-2 gap-4">
                            <div class="space-y-4">
                                <div class="aspect-w-4 aspect-h-5 rounded-2xl overflow-hidden bg-gray-100">
                                    <img 
                                        src="/img/galeria/instalaciones.webp" 
                                        alt="Instalaciones" 
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                                <div class="aspect-w-4 aspect-h-3 rounded-2xl overflow-hidden bg-gray-100">
                                    <img 
                                        src="/img/galeria/foto.webp" 
                                        alt="Equipo trabajando" 
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                            </div>
                            <div class="space-y-4 pt-8">
                                <div class="aspect-w-4 aspect-h-3 rounded-2xl overflow-hidden bg-gray-100">
                                    <img 
                                        src="/img/galeria/herramientas.webp" 
                                        alt="Herramientas" 
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                                <div class="aspect-w-4 aspect-h-5 rounded-2xl overflow-hidden bg-gray-100">
                                    <img 
                                        src="/img/galeria/stock.webp" 
                                        alt="Servicio" 
                                        class="w-full h-full object-cover"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </FadeIn>

            <FadeIn delay="0.3s">
                <!-- Beneficios y Garantías -->
                <div class="py-16 bg-gray-50/50 rounded-3xl">
                    <div class="text-center mb-12">
                        <h2 class="text-3xl font-bold text-gray-900 mb-4">Beneficios y Garantías</h2>
                        <p class="text-lg text-gray-600">Tu tranquilidad es nuestra prioridad</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto px-6">
                        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 text-center group hover:scale-105 transition-all duration-300">
                            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-red-600 text-white mx-auto mb-6">
                                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-3">Garantía de Servicio</h3>
                            <p class="text-gray-600">Respaldamos todos nuestros servicios con garantía</p>
                        </div>

                        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 text-center group hover:scale-105 transition-all duration-300">
                            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-red-600 text-white mx-auto mb-6">
                                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-3">Precios Justos</h3>
                            <p class="text-gray-600">Los mejores precios del mercado en productos originales y servicios</p>
                        </div>

                        <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 text-center group hover:scale-105 transition-all duration-300">
                            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-red-600 text-white mx-auto mb-6">
                                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-3">Servicio Express</h3>
                            <p class="text-gray-600">Atención rápida y eficiente, respetando tu tiempo</p>
                        </div>
                    </div>
                </div>
            </FadeIn>

            <FadeIn delay="0.4s">
                <!-- Equipo y Tecnología -->
                <div class="py-16">
                    <div class="text-center mb-12">
                        <h2 class="text-3xl font-bold text-gray-900 mb-4">Nuestra Tienda e Inventario</h2>
                        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                            Contamos con personal altamente capacitado y los productos mas pedidos por el publico en general
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="relative rounded-2xl overflow-hidden">
                            <img 
                                src="/img/nosotros/inventario.webp" 
                                alt="Nuestro equipo" 
                                class="w-full h-[400px] object-cover"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                            <div class="absolute bottom-0 left-0 p-6">
                                <h3 class="text-xl font-semibold text-white mb-2">Cotice con nosotros</h3>
                                <p class="text-gray-200">En nuestra tienda podras encontrar una gran variedad de productos para tu vehiculo</p>
                            </div>
                        </div>
                        <div class="relative rounded-2xl overflow-hidden">
                            <img 
                                src="/img/nosotros/equipo.webp" 
                                alt="Nuestra tecnología" 
                                class="w-full h-[400px] object-cover"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                            <div class="absolute bottom-0 left-0 p-6">
                                <h3 class="text-xl font-semibold text-white mb-2">Productos de Primera</h3>
                                <p class="text-gray-200">Con los mejores precios del mercado, no esperes mas y hablamos de tu vehiculo</p>
                            </div>
                        </div>
                    </div>
                </div>
            </FadeIn>

            <FadeIn delay="0.5s">
                <!-- CTA Final -->
                <div class="py-16">
                    <div class="relative isolate overflow-hidden bg-gradient-to-r from-red-600/90 to-red-700/90 rounded-3xl px-6 py-16 sm:px-16 sm:py-24 text-center">
                        <div class="absolute inset-0 -z-10 opacity-20 mix-blend-multiply">
                            <img src="" alt="" class="h-full w-full object-cover"/>
                        </div>
                        
                        <h2 class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
                            Confía en los Expertos
                        </h2>
                        <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-red-100">
                            Agenda una cita y experimenta la diferencia de un servicio profesional
                        </p>
                        <div class="mt-10 flex justify-center gap-6">
                            <a href="/contacto" 
                               class="rounded-xl bg-white px-6 py-3 text-sm font-semibold text-red-600 shadow-sm hover:bg-red-50 transition-all duration-300">
                                Agendar Visita
                            </a>
                            <a href="https://wa.me/56950171607" 
                               class="rounded-xl bg-red-700 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-red-800 transition-all duration-300">
                                Contactar por WhatsApp
                            </a>
                        </div>
                    </div>
                </div>
            </FadeIn>
        </Container>
    </main>
</Layout>

<style>
    .aspect-w-4 {
        aspect-ratio: 4 / 3;
    }
    .aspect-h-5 {
        aspect-ratio: 4 / 5;
    }
</style>

<script>
    const parallaxBg = document.getElementById('parallax-bg-nosotros');
    const initialScale = 1.1;
    
    window.addEventListener('scroll', () => {
        if (parallaxBg) {
            const scrolled = window.pageYOffset;
            const val = scrolled * 0.5;
            parallaxBg.style.transform = `translate3d(0, ${val}px, 0) scale(${initialScale})`;
        }
    }, { passive: true });
</script>