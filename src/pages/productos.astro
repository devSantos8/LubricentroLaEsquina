                        </div>
                    </div>
                </FadeIn>

                <div class="grid grid-cols-1 gap-y-8 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    {productos.map((producto, index) => (
                        <FadeIn delay={`${0.1 + (index * 0.05)}s`}>
                            <div class="group relative cursor-pointer" 
                                 data-litros={producto.litros}
                                 data-aplicacion={producto.aplicacion}
                                 data-descripcion={producto.descripcion}>
                                <div class="min-h-[280px] w-full overflow-hidden rounded-lg bg-white p-4 flex items-center justify-center">
                                    <img 
                                        src={producto.imagen} 
                                        alt={producto.nombre}
                                        class="h-[240px] w-auto object-contain object-center group-hover:opacity-75 transition-opacity"
                                    />
                                </div>
                                <div class="mt-4 flex justify-between">
                                    <div>
                                        <h3 class="text-sm text-gray-700">
                                            <span class="absolute inset-0"></span>
                                            {producto.nombre}
                                        </h3>
                                        <p class={`mt-1 text-sm ${
                                            producto.stock === 'disponible' ? 'text-green-600' : 
                                            producto.stock === 'bajo' ? 'text-yellow-600' : 
                                            'text-red-600'
                                        }`}>
                                            {producto.stock.charAt(0).toUpperCase() + producto.stock.slice(1)}
                                        </p>
                                    </div>
                                    <p class="text-sm font-medium text-gray-900">{producto.precio}</p>
                                </div>
                            </div>
                        </FadeIn>
                    ))}
                </div>
            </div>
