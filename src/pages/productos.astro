<script is:inline>
    function setupModal() {
        const modal = document.getElementById('productoModal');
        const closeBtn = document.getElementById('closeModal');
        const productos = document.querySelectorAll('.group.relative');
        
        productos.forEach(producto => {
            producto.addEventListener('click', (e) => {
                const nombre = producto.querySelector('h3').textContent;
                const precio = producto.querySelector('.text-gray-900').textContent;
                const imagen = producto.querySelector('img').src;
                const litros = producto.dataset.litros;
                const aplicacion = producto.dataset.aplicacion;
                const descripcion = producto.dataset.descripcion;

                document.getElementById('modalNombre').textContent = nombre;
                document.getElementById('modalPrecio').textContent = precio;
                document.getElementById('modalImagen').src = imagen;
                document.getElementById('modalLitros').textContent = litros;
                document.getElementById('modalAplicacion').textContent = aplicacion;
                document.getElementById('modalDescripcion').textContent = descripcion;
                
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            });
        });

        closeBtn?.addEventListener('click', () => {
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        });

        modal?.addEventListener('click', (e) => {
            if (e.target === modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        });
    }

    document.addEventListener('astro:page-load', setupModal);
    setupModal();
</script>

<style>
    .aspect-h-1 {
        aspect-ratio: 1 / 1;
    }

    .brands-slider {
        animation: slide 30s linear infinite;
        will-change: transform;
        display: flex;
    }

    @keyframes slide {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .brands-slider img {
        transition: all 0.3s ease;
        filter: grayscale(100%);
    }

    .brands-slider img:hover {
        filter: grayscale(0%);
        transform: scale(1.05);
    }

    @media (max-width: 640px) {
        .brands-slider {
            animation-duration: 20s;
        }
        .brands-slider img {
            width: 5rem;
            height: 2.5rem;
        }
        .brands-slider .flex {
            gap: 2rem;
        }
    }

    /* Asegura que el contenido inicial esté visible sin scroll */
    main {
        margin-top: 0;
        padding-top: 0;
    }

    /* Estilos específicos para la grid de productos en móvil */
    @media (max-width: 640px) {
        .productos-grid {
            opacity: 1 !important;
            transform: none !important;
            visibility: visible !important;
        }
    }

    /* Mantener visibilidad al cambiar tamaño de ventana */
    @media (max-width: 640px) {
        .scroll-animate {
            opacity: 0.8 !important;
            transform: translateY(10px) !important;
            transition: all 0.3s ease-out !important;
        }
        .scroll-animate.show {
            opacity: 1 !important;
            transform: none !important;
        }
    }

    /* Optimizar rendimiento */
    .group {
        will-change: transform;
        backface-visibility: hidden;
    }
</style>

<script>
    function handleProductsVisibility() {
        if (window.innerWidth <= 640) {
            requestAnimationFrame(() => {
                document.querySelectorAll('.scroll-animate').forEach(el => {
                    el.classList.add('show');
                });
            });
        }

        let resizeTimeout: number | undefined;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                if (window.innerWidth <= 640) {
                    document.querySelectorAll('.scroll-animate').forEach(el => {
                        el.classList.add('show');
                    });
                }
            }, 150);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', handleProductsVisibility);
    } else {
        handleProductsVisibility();
    }
    document.addEventListener('astro:page-load', handleProductsVisibility);
</script>