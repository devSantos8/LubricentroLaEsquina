---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title?: string;
}

const { title = "Lubricentro" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Lubricentro La Esquina - Servicio automotriz profesional">
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/img/logo/LogoLubri.png" />
        <meta name="generator" content={Astro.generator} />
        <link href="https://fonts.googleapis.com/css2?family=Onest:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <title>{title} | Lubricentro La Esquina</title>
        
    </head>
    <body class="relative">
        <Header />
        <slot />
        <Footer />

        <!-- Menú flotante circular -->
        <div class="fixed bottom-6 right-6 z-50">
            <!-- Botón principal -->
            <button id="menuButton" class="bg-red-600 w-14 h-14 rounded-full flex items-center justify-center text-white shadow-lg hover:bg-red-500 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
                </svg>
            </button>

            <!-- Menú de opciones -->
            <div id="menuOptions" class="absolute bottom-20 right-0 space-y-4 opacity-0 scale-95 transition-all duration-300 pointer-events-none">
                <!-- WhatsApp -->
                <a href="https://wa.me/56912345678" target="_blank" rel="noopener noreferrer" 
                   class="bg-green-500 w-12 h-12 rounded-full flex items-center justify-center text-white shadow-lg hover:bg-green-600 transform hover:scale-110 transition-all">
                    <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                </a>

                <!-- Instagram -->
                <a href="https://www.instagram.com/laesquina_lubricentro/" target="_blank" rel="noopener noreferrer" 
                   class="bg-gradient-to-tr from-yellow-500 via-pink-500 to-purple-500 w-12 h-12 rounded-full flex items-center justify-center text-white shadow-lg hover:opacity-90 transform hover:scale-110 transition-all">
                    <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                </a>

                <!-- Teléfono -->
                <a href="/contacto" 
                   class="bg-red-600 w-12 h-12 rounded-full flex items-center justify-center text-white shadow-lg hover:bg-red-500 transform hover:scale-110 transition-all">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                </a>
            </div>
        </div>
    </body>
</html>

<style is:global>
    :root {
        --accent: 124, 58, 237;
        --accent-gradient: linear-gradient(45deg, rgb(var(--accent)), #da62c4 30%, white 60%);
    }
    html {
        font-family: 'Onest', system-ui, sans-serif;
        background-color: #ffffff;
    }
    body {
        font-family: 'Onest', system-ui, sans-serif;
    }
    code {
        font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
            Bitstream Vera Sans Mono, Courier New, monospace;
    }
    /* Previene el flash */
    html.loading {
        opacity: 0;
    }
</style>

<script is:inline>
    function setupFloatingMenu() {
        const menuButton = document.getElementById('menuButton');
        const menuOptions = document.getElementById('menuOptions');

        if (!menuButton || !menuOptions) return;

        // Remover listeners anteriores si existen
        const oldInstance = menuButton.getAttribute('data-initialized');
        if (oldInstance) {
            menuButton.replaceWith(menuButton.cloneNode(true));
        }

        // Obtener la referencia actualizada después del clonado
        const updatedMenuButton = document.getElementById('menuButton');
        if (!updatedMenuButton) return;

        // Marcar como inicializado
        updatedMenuButton.setAttribute('data-initialized', 'true');

        updatedMenuButton.addEventListener('click', () => {
            const isHidden = menuOptions.classList.contains('opacity-0');
            
            if (isHidden) {
                menuOptions.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
                menuOptions.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
                updatedMenuButton.classList.add('rotate-90');
            } else {
                menuOptions.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
                menuOptions.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
                updatedMenuButton.classList.remove('rotate-90');
            }
        });
    }

    // Ejecutar en la carga inicial del documento
    document.addEventListener('DOMContentLoaded', setupFloatingMenu);
    
    // Ejecutar después de cada navegación de Astro
    document.addEventListener('astro:page-load', setupFloatingMenu);
</script>
